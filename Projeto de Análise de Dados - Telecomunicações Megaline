      ],
      "source": [
        "# Garantir que session_date está como datetime\n",
        "internet['session_date'] = pd.to_datetime(internet['session_date'])\n",
        "\n",
        "# Converter id e user_id para tipo numérico\n",
        "internet['id'] = pd.to_numeric(internet['id'], errors='coerce')\n",
        "internet['user_id'] = pd.to_numeric(internet['user_id'], errors='coerce')\n",
        "\n",
        "# Verificar se existem valores negativos em mb_used\n",
        "neg_mb = (internet['mb_used'] < 0).sum()\n",
        "print(f'Valores negativos em mb_used: {neg_mb}')\n",
        "\n",
        "# Se houver valores negativos (raro), zere-os (não exclua usuários!)\n",
        "internet.loc[internet['mb_used'] < 0, 'mb_used'] = 0\n",
        "\n",
        "# Verificação final\n",
        "print(internet.info())"
      ]
    },
